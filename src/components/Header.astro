---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";
---

<header class="border-b border-neutral-200 dark:border-neutral-800">
  <Container>

    <div class="flex items-center justify-between py-5">

      <!-- LOGO / NAME -->

      <Link href="/" underline={false}>

        <div class="text-lg font-semibold tracking-tight text-black dark:text-white hover:opacity-80 transition-all">

          {SITE.NAME}

        </div>

      </Link>

      <!-- NAVIGATION -->

      <nav class="flex items-center gap-5 text-sm">

        <Link href="/blog">
          <span class="opacity-70 hover:opacity-100 transition-all">
            writeups
          </span>
        </Link>

        <Link href="/work">
          <span class="opacity-70 hover:opacity-100 transition-all">
            experience
          </span>
        </Link>

        <Link href="/projects">
          <span class="opacity-70 hover:opacity-100 transition-all">
            projects
          </span>
        </Link>

        <Link href="/achievements">
          <span class="opacity-70 hover:opacity-100 transition-all">
            achievements
          </span>
        </Link>

        <Link href="/Resume_Kanishka_Jha_1.pdf">
          <span class="opacity-70 hover:opacity-100 transition-all">
            resume
          </span>
        </Link>

      </nav>

    </div>

  </Container>
</header>