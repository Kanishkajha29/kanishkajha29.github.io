          {SITE.NAME}
        </div>
      </Link>

      <nav class="flex flex-wrap items-center gap-1 text-sm md:text-base">
        <Link href="/blog">blog</Link>

        <span>{`/`}</span>

        <Link href="/work">work</Link>

        <span>{`/`}</span>

        <Link href="/projects">projects</Link>

        <span>{`/`}</span>

        <Link href="/achievements">achievements</Link>

        <span>{`/`}</span>

        <a
          href="/Resume_Kanishka_Jha_1.pdf"
          target="_blank"
          class="underline underline-offset-4 transition hover:opacity-70"
        >
          resume
        </a>
      </nav>
    </div>
  </Container>
</header>