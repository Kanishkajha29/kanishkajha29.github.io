---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
---

<PageLayout
  title="Achievements"
  description="Hall of Fame recognitions, conferences, certifications, and cybersecurity achievements."
>
  <Container>
    <div class="space-y-10">
      <div class="animate">
        <h1 class="font-semibold text-3xl text-black dark:text-white">
          Achievements
        </h1>

        <p class="mt-3 opacity-80">
          Hall of Fame recognitions, conferences, security research milestones,
          certifications, and competitive cybersecurity participation.
        </p>
      </div>

      <section class="space-y-6 animate">
        <h2 class="font-semibold text-xl text-black dark:text-white">
          Hall of Fame & Recognition
        </h2>

        <div class="space-y-4">
          <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-5 hover:border-neutral-500 transition-all">
            <h3 class="font-semibold text-black dark:text-white">
              NASA Hall of Fame
            </h3>

            <p class="opacity-80 mt-2">
              Recognized for responsibly disclosing a security vulnerability
              affecting enterprise infrastructure components.
            </p>
          </div>

          <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-5 hover:border-neutral-500 transition-all">
            <h3 class="font-semibold text-black dark:text-white">
              Philips Hall of Fame
            </h3>

            <p class="opacity-80 mt-2">
              Reported a vulnerability involving exposed GraphQL functionality
              resulting in unintended access to sensitive information.
            </p>
          </div>

          <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-5 hover:border-neutral-500 transition-all">
            <h3 class="font-semibold text-black dark:text-white">
              Oracle Recognition
            </h3>

            <p class="opacity-80 mt-2">
              Recognized through responsible vulnerability disclosure and
              security research activities.
            </p>
          </div>

          <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-5 hover:border-neutral-500 transition-all">
            <h3 class="font-semibold text-black dark:text-white">
              LATAM Airlines Recognition
            </h3>

            <p class="opacity-80 mt-2">
              Acknowledged for identifying and responsibly reporting
              security-related issues.
            </p>
          </div>
        </div>
      </section>

      <section class="space-y-6 animate">
        <h2 class="font-semibold text-xl text-black dark:text-white">
          Conferences & Research
        </h2>

        <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-5 hover:border-neutral-500 transition-all">
          <h3 class="font-semibold text-black dark:text-white">
            IEEE Research Paper Selection
          </h3>

          <p class="opacity-80 mt-2">
            Research work selected for IEEE conference consideration in the
            domain of cybersecurity and security-focused technologies.
          </p>
        </div>
      </section>

      <section class="space-y-6 animate">
        <h2 class="font-semibold text-xl text-black dark:text-white">
          Certifications & Training
        </h2>

        <div class="space-y-4">
          <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-5 hover:border-neutral-500 transition-all">
            <h3 class="font-semibold text-black dark:text-white">
              CRTP — Certified Red Team Professional
            </h3>

            <p class="opacity-80 mt-2">
              Focused on Active Directory attacks, privilege escalation,
              Kerberos abuse, delegation attacks, and lateral movement.
            </p>
          </div>

          <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-5 hover:border-neutral-500 transition-all">
            <h3 class="font-semibold text-black dark:text-white">
              Offensive Security & Active Directory Labs
            </h3>

            <p class="opacity-80 mt-2">
              Hands-on experience with enterprise Active Directory attack paths,
              internal network exploitation, and offensive security simulations.
            </p>
          </div>
        </div>
      </section>

      <section class="space-y-6 animate">
        <h2 class="font-semibold text-xl text-black dark:text-white">
          CTFs & Competitive Security
        </h2>

        <div class="space-y-4">
          <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-5 hover:border-neutral-500 transition-all">
            <h3 class="font-semibold text-black dark:text-white">DomeCTF</h3>

            <p class="opacity-80 mt-2">
              Participated in offensive security and exploitation-based
              cybersecurity challenges involving web security and privilege
              escalation scenarios.
            </p>
          </div>

          <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-5 hover:border-neutral-500 transition-all">
            <h3 class="font-semibold text-black dark:text-white">DUCTF</h3>

            <p class="opacity-80 mt-2">
              Worked on reverse engineering, web exploitation, and
              security-focused capture-the-flag challenges.
            </p>
          </div>
          <div
            class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-5 hover:border-neutral-500 transition-all"
          >
            <h3 class="font-semibold text-black dark:text-white">
              ⚡ Offensive Security Tool Development
            </h3>

            <p class="opacity-80 mt-2">
              Developed offensive security automation tooling focused on
              reconnaissance, vulnerability validation, SSL analysis, directory
              fuzzing, vhost discovery, and security reporting workflows.
            </p>
          </div>

          <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-5 hover:border-neutral-500 transition-all">
            <h3 class="font-semibold text-black dark:text-white">
              Hack The Box & Labs
            </h3>

            <p class="opacity-80 mt-2">
              Regularly practiced exploitation methodologies, Active Directory
              attack chains, privilege escalation, and internal network attacks
              across lab environments.
            </p>
          </div>
        </div>
      </section>
    </div>
  </Container>
</PageLayout>
