---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { dateRange } from "@lib/utils";
import { SITE, HOME, SOCIALS } from "@consts";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const allwork = (await getCollection("work"))
  .sort(
    (a, b) =>
      new Date(b.data.dateStart).valueOf() -
      new Date(a.data.dateStart).valueOf(),
  )
  .slice(0, SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  }),
);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="space-y-16">
      <!-- HERO -->

      <section class="animate space-y-5 pt-4">
        <div class="space-y-3">
          <div
            class="inline-flex items-center rounded-full border border-neutral-200 dark:border-neutral-800 px-4 py-1 text-sm opacity-80"
          >
            Offensive Security • Active Directory • AI Security
          </div>

          <div class="space-y-3">
            <h1
              class="text-5xl md:text-6xl font-bold tracking-tight text-black dark:text-white leading-tight"
            >
              Kanishka Jha
            </h1>

            <p class="text-lg md:text-xl opacity-80 max-w-3xl leading-relaxed">
              Offensive Security Engineer focused on penetration testing, Active
              Directory attacks, adversarial simulations, AI security testing,
              and enterprise security assessments.
            </p>

            <div class="flex flex-wrap items-center gap-2 pt-1 text-sm opacity-70">
              <span class="rounded-md border border-neutral-200 dark:border-neutral-800 px-2 py-1">
                CRTP
              </span>

              <span> Certified Red Team Professional </span>
            </div>

            <div class="flex flex-wrap items-center gap-2 pt-1 text-sm opacity-70">
              <span class="rounded-md border border-neutral-200 dark:border-neutral-800 px-2 py-1">
                CxWAP
              </span>

              <span> Certified Web Application Pentester </span>
            </div>
          </div>
        </div>
      </section>

      <!-- ABOUT -->

      <section
        class="animate border-t border-neutral-200 dark:border-neutral-800 pt-10"
      >
        <div class="space-y-5">
          <div>
            <h2 class="text-2xl font-semibold text-black dark:text-white">
              About
            </h2>
          </div>

          <div class="space-y-4 text-[15px] leading-8 opacity-90 max-w-4xl">
            <p>
              I work across offensive security, Active Directory security,
              adversarial testing, and enterprise attack simulation workflows.
            </p>

            <p>
              My experience includes internal network assessments, web
              application penetration testing, authentication abuse testing,
              privilege escalation analysis, cloud security validation, and AI
              security testing.
            </p>

            <p>
              I actively build offensive security tooling, vulnerable labs, and
              technical research focused on Active Directory attacks, enterprise
              attack paths, web exploitation, and adversarial AI.
            </p>

            <p>
              My security research and responsible disclosure efforts have been
              recognized by organizations including NASA, Philips, Oracle, and
              LATAM Airways.
            </p>
          </div>
        </div>
      </section>

      <!-- STATS -->

      <section class="animate">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div
            class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-5 hover:border-neutral-500 transition-all"
          >
            <div class="text-3xl font-bold text-black dark:text-white">4+</div>

            <div class="mt-2 text-sm opacity-80">
              Hall of Fame & Security Recognitions
            </div>
          </div>

          <div
            class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-5 hover:border-neutral-500 transition-all"
          >
            <div class="text-3xl font-bold text-black dark:text-white">
              AD / Web / Cloud
            </div>

            <div class="mt-2 text-sm opacity-80">
              Enterprise Offensive Security Assessments
            </div>
          </div>

          <div
            class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-5 hover:border-neutral-500 transition-all"
          >
            <div class="text-3xl font-bold text-black dark:text-white">
              CTF / Research
            </div>

            <div class="mt-2 text-sm opacity-80">
              Active Directory, Adversarial Testing & Security Tooling
            </div>
          </div>
        </div>
      </section>

      <!-- WRITEUPS -->

      <section class="animate space-y-5">
        <div class="flex items-center justify-between flex-wrap gap-y-2">
          <h2 class="text-2xl font-semibold text-black dark:text-white">
            Latest Writeups
          </h2>

          <Link href="/blog"> View all </Link>
        </div>

        <ul class="flex flex-col gap-4">
          {
            blog.map((post) => (
              <li>
                <ArrowCard entry={post} />
              </li>
            ))
          }
        </ul>
      </section>

      <!-- EXPERIENCE -->

      <section class="animate space-y-5">
        <div class="flex items-center justify-between flex-wrap gap-y-2">
          <h2 class="text-2xl font-semibold text-black dark:text-white">
            Experience
          </h2>

          <Link href="/work"> View all </Link>
        </div>

        <ul class="flex flex-col gap-4">
          {
            work.map((entry) => (
              <li class="rounded-xl border border-neutral-200 dark:border-neutral-800 p-5 hover:border-neutral-500 transition-all">
                <div class="text-sm opacity-70">
                  {dateRange(entry.data.dateStart, entry.data.dateEnd)}
                </div>

                <div class="font-semibold text-lg text-black dark:text-white mt-1">
                  {entry.data.company}
                </div>

                <div class="text-sm opacity-70">{entry.data.role}</div>

                <article class="mt-3 opacity-85 leading-7">
                  <entry.Content />
                </article>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- PROJECTS -->

      <section class="animate space-y-5">
        <div class="flex items-center justify-between flex-wrap gap-y-2">
          <h2 class="text-2xl font-semibold text-black dark:text-white">
            Security Projects
          </h2>

          <Link href="/projects"> View all </Link>
        </div>

        <ul class="flex flex-col gap-4">
          {
            projects.map((project) => (
              <li>
                <ArrowCard entry={project} />
              </li>
            ))
          }
        </ul>
      </section>

      <!-- CONNECT -->

      <section
        class="animate border-t border-neutral-200 dark:border-neutral-800 pt-10"
      >
        <div class="space-y-5">
          <h2 class="text-2xl font-semibold text-black dark:text-white">
            Connect
          </h2>

          <p class="opacity-80 leading-7 max-w-3xl">
            Open to discussions around offensive security, Active Directory,
            adversarial testing, enterprise security assessments, cybersecurity
            tooling, and security research collaboration.
          </p>

          <ul class="flex flex-wrap gap-3">
            {
              SOCIALS.map((SOCIAL) => (
                <li>
                  <Link
                    href={SOCIAL.HREF}
                    external
                    aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}
                  >
                    {SOCIAL.NAME}
                  </Link>
                </li>
              ))
            }

            <li>
              <Link
                href={`mailto:${SITE.EMAIL}`}
                aria-label={`Email ${SITE.NAME}`}
              >
                {SITE.EMAIL}
              </Link>
            </li>
          </ul>
        </div>
      </section>
    </div>
  </Container>
</PageLayout>
